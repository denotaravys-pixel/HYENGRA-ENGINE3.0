{
  "schemaVersion": 1,
  "id": "hyengra",
  "version": "${version}",
  "name": "Hyengra Engine",
  "description": "Custom rendering engine for Minecraft 1.21.1",
  "authors": [],
  "license": "LGPL-3.0-only",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.hyengra.mod.HyengraMod"
    ],
    "client": [
      "com.hyengra.mod.HyengaModClient"
    ]
  },
  "mixins": [
    "mixins.hyengra.json",
    {
      "config": "mixins.hyengra.client.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
